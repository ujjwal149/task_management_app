DATABASE_URL=postgresql://user:password@localhost:5432/taskflow
CLIENT_URL=http://localhost:3000
PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
# Generate a separate secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
RESEND_API_KEY=re_replace_with_your_sending_api_key
# Must use a domain verified in Resend to send to real users.
EMAIL_FROM=TaskFlow <auth@your-verified-domain.com>
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Set only to the exact number of trusted proxies between the internet and Express.
TRUST_PROXY_HOPS=0
